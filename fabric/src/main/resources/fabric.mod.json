{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_author}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["io.izzel.minecraftmcp.fabric.FabricMinecraftMcpCommonEntrypoint"],
    "client": ["io.izzel.minecraftmcp.fabric.FabricMinecraftMcpEntrypoint"],
    "server": ["io.izzel.minecraftmcp.fabric.FabricMinecraftMcpServerEntrypoint"]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
